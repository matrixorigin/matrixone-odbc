<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Property Id="ARPCOMMENTS" Value="MatrixOne ODBC $(var.odbc_ver_short) connects ODBC applications to MatrixOne." />
  <Property Id="ARPCONTACT" Value="https://github.com/matrixorigin/matrixone-odbc" />
  <Property Id="ARPPRODUCTICON" Value="MySQLConnector.ico" />
  <Property Id="ARPHELPLINK" Value="https://github.com/matrixorigin/matrixone-odbc/issues" />
  <Property Id="ARPURLINFOABOUT" Value="https://github.com/matrixorigin/matrixone-odbc" />
  <Property Id="ARPURLUPDATEINFO" Value="https://github.com/matrixorigin/matrixone-odbc/releases" />
  <!--Property Id="ARPHELPTELEPHONE" Value="URL where one can find support phone numbers" /-->
  <Property Id="ARPAUTHORIZEDCDFPREFIX" Value="https://github.com/matrixorigin/matrixone-odbc" />
  <Property Id="ARPSIZE" Value="3" />
  <Property Id="INSTALLSUMMARY" Value="Install Summary:"/>
  <Property Id="SUMMARYDRIVER" Value=" "/>
  <Property Id="SUMMARYPBI" Value=" "/>
  <Property Id="NAMEDRIVER" Value="MatrixOne ODBC $(var.odbc_ver_short)$(var.odbc_license_suffix) ($(var.odbc_arch))"/>
  <Property Id="NAMEPBI" Value="Power BI extension for MatrixOne"/>

  <!--
  <Property Id="ARPNOMODIFY" Value="0" />
  <Property Id="ARPNOREPAIR" Value="0" />
  <Property Id="ARPNOREMOVE" Value="0" />
  <Property Id="ARPSYSTEMCOMPONENT" Value="0" />
  -->

  <Icon Id="MySQLConnector.ico" SourceFile="$(var.odbc_resource)/MySQLConnector.ico" />

  <!-- Set up ARPINSTALLLOCATION property -->
  <CustomAction Id="SetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
  <CustomAction Id="SetARPREADME" Property="ARPREADME" Value="[INSTALLDIR]README" />

  <!-- Sequences -->
  <InstallExecuteSequence>
    <Custom Action="SetARPINSTALLLOCATION" After="InstallValidate"></Custom>
    <Custom Action="SetARPREADME" After="InstallValidate"></Custom>
  </InstallExecuteSequence>
</Include>
